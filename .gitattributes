# 统一换行符，避免 Windows/Linux 协作时的无意义 diff 噪声
* text=auto eol=lf

*.py text
*.pyi text
*.toml text
*.yaml text
*.yml text
*.json text
*.md text
*.sh text
*.html text
*.css text
*.js text

# 锁定文件需可 diff
uv.lock text eol=lf

# 二进制资源保持原样
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.parquet binary
*.sqlite3 binary
*.safetensors binary
