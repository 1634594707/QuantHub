++    def _transition(
++        self,
++        order_id: str,
++        status: str,
++        *,
++        external_order_id: str | None = None,
++        filled_quantity: float | None = None,
++        average_price: float | None = None,
++        payload: dict[str, Any] | None = None,
++    ) -> None:
++        with connect(self.database_path) as connection:
++            row = connection.execute("SELECT * FROM orders WHERE order_id=?", (order_id,)).fetchone()
++            if row is None:
++                raise LookupError("order not found")
++            current = row["status"]
++            if current == status:
++                connection.execute(
++                    """UPDATE orders SET external_order_id=COALESCE(?, external_order_id),
++                        filled_quantity=COALESCE(?, filled_quantity),
++                        average_price=COALESCE(?, average_price), updated_at=? WHERE order_id=?""",
++                    (
++                        external_order_id,
++                        filled_quantity,
++                        average_price,
++                        datetime.now(UTC).isoformat(),
++                        order_id,
++                    ),
++                )
++                return
++            if current in FINAL_STATUSES:
++                if current == status:
++                    return
++                raise ValueError(f"cannot transition final order from {current} to {status}")
++            if status not in TRANSITIONS.get(current, set()):
++                raise ValueError(f"invalid order transition {current} -> {status}")
++            safe_payload = _redact_payload(payload or {})
++            connection.execute(
++                """UPDATE orders SET status=?, external_order_id=COALESCE(?, external_order_id),
++                    filled_quantity=COALESCE(?, filled_quantity),
++                    average_price=COALESCE(?, average_price), updated_at=? WHERE order_id=?""",
++                (
++                    status,
++                    external_order_id,
++                    filled_quantity,
++                    average_price,
++                    datetime.now(UTC).isoformat(),
++                    order_id,
++                ),
++            )
++            self._event(
++                connection, order_id, current, status, external_order_id, safe_payload
++            )
