++def _redact_payload(value: Any) -> Any:
++    if isinstance(value, dict):
++        return {
++            key: (
++                "[REDACTED]"
++                if any(token in key.lower() for token in ("api_key", "secret", "token", "passphrase", "private_key"))
++                else _redact_payload(item)
++            )
++            for key, item in value.items()
