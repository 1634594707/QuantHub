++                "permissions": "trade" if self.environment in {"demo", "live"} else "read_only",
++                "latest_snapshot_at": latest_snapshot_at.isoformat() if latest_snapshot_at else None,
++                "stale": snapshot_stale,
++                "last_reconciliation_at": reconciliation_events["created_at"] if reconciliation_events else None,
++                "server_time": now.isoformat(),
++            },
++        }
