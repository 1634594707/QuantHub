++                    updated_at=excluded.updated_at""",
++                (scope, mode, reason, datetime.now(UTC).isoformat()),
++            )
++            self._audit(
++                connection,
++                "risk_mode_changed",
++                {"scope": scope, "mode": mode, "reason": reason, "operator": operator},
++            )
++        return {"scope": scope, "mode": mode, "reason": reason, "operator": operator}
