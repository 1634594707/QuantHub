QH_RUNNER_HOST=0.0.0.0
QH_RUNNER_PORT=8103
QH_RUNNER_DATABASE_PATH=/data/runner-demo.db
QH_RUNNER_ENVIRONMENT=demo
QH_RUNNER_SIGNING_KEY=must-match-factor-package-verification-key
QH_RUNNER_AUTH_TOKEN=replace-with-a-random-operator-token
# Desktop Demo: set local_vault and enter credentials once on the Web settings page.
QH_OKX_CREDENTIAL_SOURCE=local_vault
# Headless deployment alternative: set source=environment and inject all three OKX values
# from deployment secret storage. Never write credential values in this file.
